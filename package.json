{
  "name": "battle-monsters-mobile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "mobile:sync": "vite build --mode mobile && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "models:build": "blender -b --threads 4 --python scripts/models/build_creatures.py -- --all && node scripts/optimize-models.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@gltf-transform/cli": "^4.2.1",
    "@vitejs/plugin-react": "^4.4.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jsdom": "^26.1.0",
    "vite": "^6.3.0"
  }
}
